#!/bin/bash
# First boot of the HopCharlie management host (rendered by Terraform, runs
# once). It only installs Docker and hands over to sync.sh, which reads every
# setting from SSM; settings change through ./redeploy.sh, never through this
# file, so the host is not replaced when they change.
# Log: /var/log/hopcharlie-bootstrap.log, then /var/log/hopcharlie-sync.log
set -euo pipefail
exec > >(tee -a /var/log/hopcharlie-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL -o /usr/libexec/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/${compose_plugin}/docker-compose-linux-x86_64
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

install -d -m 0755 /opt/hopcharlie
aws ssm get-parameter --region ${region} --name "${prefix}/host/sync.sh" \
  --query Parameter.Value --output text > /opt/hopcharlie/sync.sh

# The images may be pushed after the host boots; keep trying for 20 minutes.
for i in $(seq 1 60); do
  bash /opt/hopcharlie/sync.sh ${region} ${prefix} && break
  echo "sync failed (attempt $i); retrying in 20s"
  sleep 20
done
echo "bootstrap done"
